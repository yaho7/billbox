# GitHub Actions 推送到 GHCR 后使用的镜像地址。
BILLBOX_IMAGE=ghcr.io/yaho7/billbox:main
BILLBOX_PORT=8000

# 必填。SESSION_SECRET 可用 `openssl rand -hex 32` 生成。
APP_PASSWORD=replace-with-a-strong-password
SESSION_SECRET=replace-with-at-least-32-random-characters

# 直接通过 http://127.0.0.1 访问时保持 false；HTTPS 反代后改为 true。
SESSION_COOKIE_SECURE=false
SESSION_TTL_SECONDS=43200
FORWARDED_ALLOW_IPS=127.0.0.1

# 可选。不填写时仍可手动记账，但邮件自动归集不会启用。
MAIL_USER=
MAIL_PASSWORD=
IMAP_SERVER=
IMAP_PORT=993
MAX_EMAILS=50

SCHEDULE_ENABLED=true
SCHEDULE_HOUR=3
SCHEDULE_MINUTE=30
SCHEDULE_TIMEZONE=Asia/Shanghai
